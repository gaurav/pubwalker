# Copy to .env and fill in what you have. Every key is optional; leave a line blank to skip it.

# OpenAlex (https://openalex.org). Polite pool needs a contact email; a free API key raises
# the rate limit. Get a key at https://openalex.org -> "Get an API key".
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Semantic Scholar (https://www.semanticscholar.org/product/api). Anonymous access works but
# shares a small rate-limit pool; a free key gives 1 request/second of your own.
S2_API_KEY=

# NCBI E-utilities (https://www.ncbi.nlm.nih.gov/account/settings/). A key raises the limit
# from 3 to 10 requests/second. The email is sent as the tool contact.
NCBI_API_KEY=
NCBI_EMAIL=

# Anthropic API key. NOT needed: the pipeline calls `claude -p`, which uses your Claude Code
# login. Set this only if you would rather bill an API key directly.
ANTHROPIC_API_KEY=
